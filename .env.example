# Copiar como /opt/resumen-escolar/config/automation.env en la VM.
# No guardar credenciales reales en Git.

RESUMEN_ESCOLAR_APP_DIR=/opt/resumen-escolar
RESUMEN_ESCOLAR_LOG_DIR=/opt/resumen-escolar/logs
RESUMEN_ESCOLAR_PYTHON=python3

# Navegador usado por Playwright en Linux. "playwright" usa Chromium instalado por Playwright.
RESUMEN_ESCOLAR_BROWSER_EXE=chromium
RESUMEN_ESCOLAR_PROFILE_DIR=/opt/resumen-escolar/.runtime/chrome-profile
# Si Chromium ya corre con depuracion remota, usar por ejemplo http://127.0.0.1:9222
RESUMEN_ESCOLAR_CDP_URL=http://127.0.0.1:9222
RESUMEN_ESCOLAR_HEADLESS=1
PLAYWRIGHT_BROWSERS_PATH=/home/ubuntu/.cache/ms-playwright

# Object Storage. Usar instance principal en la VM para no guardar API keys.
RESUMEN_ESCOLAR_BUCKET=
RESUMEN_ESCOLAR_OCI_REGION=ca-toronto-1
RESUMEN_ESCOLAR_OCI_NAMESPACE=
RESUMEN_ESCOLAR_OCI_AUTH=instance_principal
RESUMEN_ESCOLAR_OCI_CLI=oci
RESUMEN_ESCOLAR_DAILY_REPORT_LATEST_OBJECT=latest/daily_report.txt
RESUMEN_ESCOLAR_DAILY_REPORT_ARCHIVE_TEMPLATE=archive/{date}/daily_report.txt
RESUMEN_ESCOLAR_DAILY_STATE_LATEST_OBJECT=latest/daily_report_state.json
RESUMEN_ESCOLAR_DAILY_STATE_ARCHIVE_TEMPLATE=archive/{date}/daily_report_state.json
RESUMEN_ESCOLAR_ARCHIVE=1
RESUMEN_ESCOLAR_MATERIALS_LATEST_PREFIX=latest/materials
RESUMEN_ESCOLAR_MATERIALS_ARCHIVE_TEMPLATE=archive/{date}/materials

# Paquete desechable de materiales recientes de Classroom.
# V1 no usa OCR: extrae texto visible y guarda copias best-effort de archivos seleccionados.
RESUMEN_ESCOLAR_CLASSROOM_MATERIAL_WINDOW_DAYS=7
RESUMEN_ESCOLAR_CLASSROOM_MATERIAL_MAX_RECORDS=10
RESUMEN_ESCOLAR_CLASSROOM_MATERIAL_MAX_PER_SUBJECT=3
RESUMEN_ESCOLAR_CLASSROOM_MATERIAL_MAX_FILE_BYTES=15728640
RESUMEN_ESCOLAR_CLASSROOM_MATERIAL_TEXT_CHARS=3000

# Notificacion opcional al publicar el reporte diario.
# Crear un topic en OCI Notifications, suscribir un email y confirmar la suscripcion.
# Luego configurar el OCID del topic en la VM.
RESUMEN_ESCOLAR_NOTIFICATION_TOPIC_OCID=
# Presupuesto UTF-8 para el cuerpo de OCI Notifications (limite del servicio: 64 KB).
RESUMEN_ESCOLAR_EMAIL_MAX_BYTES=55000

# Credenciales SchoolNet.
# Preferido en la VM: OCID de un OCI Vault Secret con JSON {"username":"...","password":"..."}.
# El runner lo lee con instance principal y no escribe la clave en disco.
RESUMEN_ESCOLAR_SCHOOLNET_SECRET_OCID=

# Credencial web Google para cuando expire la sesion de Classroom.
# Guardar JSON {"username":"...","password":"..."} en OCI Vault y configurar solo su OCID aqui.
# MFA/CAPTCHA siguen requiriendo intervencion humana en Chrome de la VM.
RESUMEN_ESCOLAR_GOOGLE_SECRET_OCID=

# Fallback local/manual. No usar valores reales en Git.
# RESUMEN_ESCOLAR_SCHOOLNET_USERNAME=
# RESUMEN_ESCOLAR_SCHOOLNET_PASSWORD=

# Variables legacy para instalaciones antiguas; el correo diario no usa PAR ni URLs publicas.
RESUMEN_ESCOLAR_PAR_NAME=resumen-escolar-latest-readonly
RESUMEN_ESCOLAR_PAR_EXPIRES=
